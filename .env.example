PORT=3000
NODE_ENV=production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API via CORS.
# Leave unset to keep CORS disabled.
CORS_ORIGIN=

# Express "trust proxy" setting - set this when deploying behind a reverse
# proxy/load balancer (e.g. "1" for one hop) so req.ip/req.ips reflect the
# real client IP. Leave unset to not trust proxy headers.
TRUST_PROXY=
