// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             Role     @default(CUSTOMER)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart Cart?

  @@map("users")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  category      String
  description   String?
  priceCents    Int
  currency      String   @default("USD")
  active        Boolean  @default(true)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems CartItem[]

  // Trigram index: makes case-insensitive "contains" search on name index-friendly.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  // Serves category-only filters and combined category+price-range filters (leftmost prefix).
  @@index([category, priceCents])
  // Serves price-range filters with no category given.
  @@index([priceCents])
  // Serves the default shopper browse: WHERE active = true ORDER BY createdAt DESC.
  // Every shopper-facing query hardcodes activeOnly, so this is the most-hit path
  // and previously had no index at all (seq scan + sort).
  @@index([active, createdAt(sort: Desc)])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}
