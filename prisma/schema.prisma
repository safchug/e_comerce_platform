// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             Role     @default(CUSTOMER)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart   Cart?
  orders Order[]

  @@map("users")
}

model Product {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  category      String
  description   String?
  priceCents    Int
  currency      String   @default("USD")
  active        Boolean  @default(true)
  stockQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Trigram index: makes case-insensitive "contains" search on name index-friendly.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  // Serves category-only filters and combined category+price-range filters (leftmost prefix).
  @@index([category, priceCents])
  // Serves price-range filters with no category given.
  @@index([priceCents])
  // Serves the default shopper browse: WHERE active = true ORDER BY createdAt DESC.
  // Every shopper-facing query hardcodes activeOnly, so this is the most-hit path
  // and previously had no index at all (seq scan + sort).
  @@index([active, createdAt(sort: Desc)])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

// An Order is a point-in-time snapshot, not a live view like Cart: prices
// and totals are frozen at placement time, so later product price changes
// never alter a past order (see PlaceOrderUseCase / OrderItem.unitPriceCents).
model Order {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  status        OrderStatus @default(PENDING)
  currency      String
  subtotalCents Int
  discountCents Int
  taxRate       Float
  taxCents      Int
  totalCents    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  // Deliberately not Cascade (unlike CartItem->Product): a past order must
  // survive the product it references being deleted from the catalog.
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPriceCents Int
  currency       String

  @@map("order_items")
}
