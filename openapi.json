  "info": {
    "title": "E-Commerce Platform API",
    "description": "OpenAPI documentation for the e-commerce platform API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "description": "Process uptime in seconds",
            "example": 12345.67
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp of the response",
            "example": "2026-08-06T12:00:00.000Z"
          }
        },
        "required": ["status", "uptime", "timestamp"]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "description": "HTTP status code",
            "example": 400
          },
          "message": {
            "description": "Human-readable error message",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          }
        },
        "required": ["statusCode", "message"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Minimum 8 characters",
            "example": "Str0ngPassw0rd!"
          }
        },
        "required": ["email", "password"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the user",
            "example": "3f6a9b2e-8c1d-4e3a-9f5b-1a2b3c4d5e6f"
          },
          "email": {
            "type": "string",
            "description": "Email address of the user",
            "example": "jane.doe@example.com"
          },
          "role": {
            "enum": ["CUSTOMER", "ADMIN"],
            "type": "string",
            "description": "Role assigned to the user",
            "example": "CUSTOMER"
          }
        },
        "required": ["id", "email", "role"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "example": "Str0ngPassw0rd!"
          }
        },
        "required": ["email", "password"]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT used to authenticate subsequent requests",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived token used to obtain a new token pair via /auth/refresh",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": {
            "description": "The authenticated user",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserResponseDto"
              }
            ]
          }
        },
        "required": ["accessToken", "refreshToken", "user"]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token issued by /auth/login or a previous /auth/refresh call",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["refreshToken"]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT used to authenticate subsequent requests",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived token used to obtain a new token pair via /auth/refresh",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["accessToken", "refreshToken"]
      },
      "AdminMessageDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Admin access confirmed"
          }
        },
        "required": ["message"]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "example": "WM-1000"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Wireless Mouse"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "example": "Ergonomic wireless mouse with USB receiver"
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "description": "Price in whole cents",
            "example": 2999
          },
          "currency": {
            "type": "string",
            "example": "USD",
            "default": "USD"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "stockQuantity": {
            "type": "number",
            "minimum": 0,
            "description": "Units available in stock",
            "default": 0
          }
        },
        "required": ["sku", "name", "category", "priceCents"]
      },
      "ProductResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the product",
            "example": "3f6a9b2e-8c1d-4e3a-9f5b-1a2b3c4d5e6f"
          },
          "sku": {
            "type": "string",
            "example": "WM-1000"
          },
          "name": {
            "type": "string",
            "example": "Wireless Mouse"
          },
          "category": {
            "type": "string",
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Ergonomic wireless mouse with USB receiver"
          },
          "priceCents": {
            "type": "number",
            "description": "Price in whole cents",
            "example": 2999
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "active": {
            "type": "boolean"
          },
          "stockQuantity": {
            "type": "number",
            "description": "Units available in stock"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "priceCents",
          "currency",
          "active",
          "stockQuantity",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Wireless Mouse"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "example": "Ergonomic wireless mouse with USB receiver"
          },
          "priceCents": {
            "type": "number",
            "minimum": 1,
            "description": "Price in whole cents",
            "example": 2999
          },
          "currency": {
            "type": "string",
            "example": "USD",
            "default": "USD"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "stockQuantity": {
            "type": "number",
            "minimum": 0,
            "description": "Units available in stock",
            "default": 0
          }
        }
      },
      "ProductCategoriesResponseDto": {
        "type": "object",
        "properties": {
          "categories": {
            "description": "Distinct category values currently in the active catalog",
            "example": ["Books", "Electronics", "Home & Kitchen"],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["categories"]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total number of matching products",
            "example": 137
          },
          "page": {
            "type": "number",
            "description": "Current page (1-based)",
            "example": 1
          },
          "limit": {
            "type": "number",
            "description": "Items per page",
            "example": 20
          },
          "totalPages": {
            "type": "number",
            "description": "Total number of pages",
            "example": 7
          },
          "hasNextPage": {
            "type": "boolean",
            "description": "Whether a next page exists",
            "example": true
          }
        },
        "required": ["total", "page", "limit", "totalPages", "hasNextPage"]
      },
      "PaginatedProductsResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": ["data", "meta"]
      },
      "CartItemResponseDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "3f6a9b2e-8c1d-4e3a-9f5b-1a2b3c4d5e6f"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unitPriceCents": {
            "type": "number",
            "description": "Current unit price, in cents",
            "example": 1999
          },
          "lineTotalCents": {
            "type": "number",
            "description": "unitPriceCents x quantity, in cents",
            "example": 3998
          }
        },
        "required": [
          "productId",
          "quantity",
          "unitPriceCents",
          "lineTotalCents"
        ]
      },
      "CartResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the cart",
            "example": "9c1a2b3c-4d5e-6f7a-8b9c-0d1e2f3a4b5c"
          },
          "userId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemResponseDto"
            }
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "subtotalCents": {
            "type": "number",
            "description": "Sum of line totals, in cents",
            "example": 3998
          },
          "discountCents": {
            "type": "number",
            "description": "Discount applied, in cents",
            "example": 0
          },
          "taxRate": {
            "type": "number",
            "description": "Flat tax rate applied, e.g. 0.0825 for 8.25%",
            "example": 0.0825
          },
          "taxCents": {
            "type": "number",
            "description": "Tax charged on the post-discount amount, in cents",
            "example": 330
          },
          "totalCents": {
            "type": "number",
            "description": "subtotalCents - discountCents + taxCents",
            "example": 4328
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "items",
          "currency",
          "subtotalCents",
          "discountCents",
          "taxRate",
          "taxCents",
          "totalCents",
          "createdAt",
          "updatedAt"
        ]
      },
      "AddCartItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "example": "3f6a9b2e-8c1d-4e3a-9f5b-1a2b3c4d5e6f"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "description": "Units to add",
            "example": 1
          }
        },
        "required": ["productId", "quantity"]
      },
      "SetCartItemQuantityDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "minimum": 1,
            "description": "Absolute quantity for this line",
            "example": 3
          }
        },
        "required": ["quantity"]
      }
    }
  }
}
